#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="$HOME/.local/bin/mise"
upstream_url="https://github.com/router-for-me/CLIProxyAPI"
cd "$repo_root"

echo "Installing system prerequisites..."
missing_packages=()
command -v curl >/dev/null 2>&1 || missing_packages+=(curl)
command -v git >/dev/null 2>&1 || missing_packages+=(git)
command -v gcc >/dev/null 2>&1 || missing_packages+=(build-essential)
command -v zip >/dev/null 2>&1 || missing_packages+=(zip)
if ((${#missing_packages[@]})); then
  export DEBIAN_FRONTEND=noninteractive
  apt_get=(apt-get)
  if ((EUID != 0)); then
    apt_get=(sudo -n apt-get)
  fi
  "${apt_get[@]}" update
  "${apt_get[@]}" install -y --no-install-recommends ca-certificates "${missing_packages[@]}"
fi

if [[ ! -x "$mise_bin" ]]; then
  echo "Installing mise..."
  curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"

profile_marker="# CLIProxyAPI mise shims"
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# CLIProxyAPI mise shims
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
EOF
fi

echo "Installing project toolchains with mise..."
"$mise_bin" trust --yes "$repo_root/mise.toml"
"$mise_bin" install --yes

echo "Configuring the local fnox age provider..."
fnox_dir="$HOME/.config/fnox"
fnox_config="$fnox_dir/config.toml"
age_key="$fnox_dir/age.txt"
install -d -m 700 "$fnox_dir"
if [[ ! -f "$age_key" ]]; then
  umask 077
  "$mise_bin" exec -- age-keygen -o "$age_key" >/dev/null 2>&1
fi
chmod 600 "$age_key"
if [[ ! -f "$fnox_config" ]]; then
  "$mise_bin" exec -- fnox init --global --skip-wizard >/dev/null
fi
if ! FNOX_NON_INTERACTIVE=true "$mise_bin" exec -- fnox --no-color provider list | grep -Fqx local; then
  age_recipient="$("$mise_bin" exec -- age-keygen -y "$age_key")"
  printf '\n[providers.local]\ntype = "age"\nrecipients = ["%s"]\nkey_file = "%s"\n' \
    "$age_recipient" "$age_key" >>"$fnox_config"
fi
chmod 600 "$fnox_config"
FNOX_NON_INTERACTIVE=true "$mise_bin" exec -- fnox --no-color provider test local >/dev/null

echo "Downloading Go modules..."
"$mise_bin" exec -- go mod download

if git -C "$repo_root" remote get-url upstream >/dev/null 2>&1; then
  git -C "$repo_root" remote set-url upstream "$upstream_url"
else
  git -C "$repo_root" remote add upstream "$upstream_url"
fi

echo "Orb setup complete."
